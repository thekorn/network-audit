<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{{ metadata.app }} · Network audit</title>
    <script>
      (() => {
        let dark = matchMedia("(prefers-color-scheme: dark)").matches;
        try {
          const saved = localStorage.getItem("network-audit-theme");
          if (saved === "dark" || saved === "light") dark = saved === "dark";
        } catch {}
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f6f8;
        --surface: #fff;
        --text: #17212b;
        --muted: #627080;
        --border: #dfe4ea;
        --accent: #216655;
        --soft: #e5f1ec;
        --bad: #a53530;
        --subtle: #f4f6f8;
        --accent-border: #c1d9ce;
        --bad-border: #e5bab6;
        --bad-soft: #fbece9;
        --mono: ui-monospace, SFMono-Regular, Consolas, monospace;
      }
      html.dark {
        color-scheme: dark;
        --bg: #14191f;
        --surface: #1c242c;
        --text: #e3eaf0;
        --muted: #a1afbd;
        --border: #34424e;
        --accent: #8fd7bb;
        --soft: #203d33;
        --bad: #ffaaa3;
        --subtle: #161d24;
        --accent-border: #416956;
        --bad-border: #7b4c47;
        --bad-soft: #472d2b;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font:
          15px/1.55 system-ui,
          sans-serif;
      }
      main {
        max-width: 1240px;
        margin: auto;
        padding: 44px 32px 100px;
      }
      header {
        border-bottom: 1px solid var(--border);
        padding-bottom: 26px;
      }
      .masthead {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      #theme {
        font-size: 12px;
        white-space: nowrap;
      }
      .eyebrow {
        font: 600 12px var(--mono);
        letter-spacing: 2px;
        color: var(--accent);
        text-transform: uppercase;
      }
      .title {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
      }
      h1 {
        font-size: 38px;
        letter-spacing: -1.5px;
        margin: 12px 0;
      }
      h2 {
        font-size: 20px;
        letter-spacing: -0.4px;
        margin: 0 0 16px;
      }
      h3 {
        font-size: 14px;
        margin: 18px 0 8px;
      }
      .muted,
      small {
        color: var(--muted);
      }
      .pill {
        border: 1px solid var(--accent-border);
        border-radius: 20px;
        background: var(--soft);
        color: var(--accent);
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 650;
      }
      .pill[data-state="failed"] {
        color: var(--bad);
        border-color: var(--bad-border);
        background: var(--bad-soft);
      }
      .meta {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .mono {
        font-family: var(--mono);
        font-size: 12px;
        overflow-wrap: anywhere;
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin: 26px 0;
      }
      .stat,
      .panel {
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 12px;
        padding: 20px;
      }
      .stat strong {
        display: block;
        font-size: 29px;
        letter-spacing: -1px;
      }
      .stat span {
        font-size: 12px;
        color: var(--muted);
      }
      .context {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 30px;
      }
      .context p {
        margin: 5px 0;
        font-size: 13px;
      }
      figure {
        margin: 0;
      }
      .bars {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .bars li {
        display: grid;
        grid-template-columns: minmax(110px, 1fr) 1fr 35px;
        align-items: center;
        gap: 16px;
        margin: 10px 0;
        font: 12px var(--mono);
      }
      .bars span {
        overflow-wrap: anywhere;
      }
      .bars .empty-hosts {
        display: block;
        color: var(--muted);
      }
      meter {
        width: 100%;
        height: 12px;
      }
      meter::-webkit-meter-bar {
        background: var(--subtle);
        border: 0;
      }
      meter::-webkit-meter-optimum-value {
        background: var(--accent);
      }
      .toolbar {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
      }
      input,
      select,
      button {
        font: inherit;
        border: 1px solid var(--border);
        border-radius: 7px;
        background: var(--surface);
        padding: 10px 12px;
        color: var(--text);
      }
      input {
        flex: 1;
        min-width: 180px;
      }
      button {
        cursor: pointer;
      }
      button:hover {
        border-color: var(--accent);
      }
      :focus-visible {
        outline: 3px solid #7fbca9;
        outline-offset: 2px;
      }
      .exchange {
        border: 1px solid var(--border);
        background: var(--surface);
        border-radius: 9px;
        margin: 8px 0;
        overflow: hidden;
      }
      .exchange > summary {
        cursor: pointer;
        display: grid;
        grid-template-columns: 28px 62px minmax(0, 1fr) 60px 80px;
        gap: 12px;
        align-items: center;
        padding: 16px;
        font: 12px var(--mono);
        list-style: none;
      }
      .exchange > summary:before {
        content: "+";
        color: var(--muted);
      }
      .exchange[open] > summary:before {
        content: "−";
      }
      .url {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .status {
        color: var(--accent);
        font-weight: 700;
      }
      .error {
        color: var(--bad);
      }
      .duration {
        text-align: right;
        color: var(--muted);
      }
      .detail {
        border-top: 1px solid var(--border);
        padding: 20px;
      }
      .full-url {
        overflow-wrap: anywhere;
        margin: 0 0 12px;
      }
      .messages {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
      }
      .message {
        min-width: 0;
      }
      .query-params {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        background: var(--subtle);
        font: 12px/1.65 var(--mono);
      }
      .query-params th,
      .query-params td {
        border: 1px solid var(--border);
        padding: 8px 14px;
        text-align: left;
        vertical-align: top;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      pre {
        background: var(--subtle);
        border: 1px solid var(--border);
        border-radius: 7px;
        padding: 14px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        max-height: 460px;
        overflow: auto;
        font: 12px/1.65 var(--mono);
        margin: 0;
      }
      details details summary {
        cursor: pointer;
        font-size: 13px;
        padding: 8px 0;
      }
      .notice {
        font-size: 12px;
        color: var(--muted);
      }
      #diagnostics[data-empty="true"] {
        display: none;
      }
      #diagnostics {
        border-left: 3px solid var(--bad);
        padding: 1px 16px;
        margin-bottom: 24px;
        overflow-wrap: anywhere;
      }
      #diagnostics p {
        margin: 8px 0;
        white-space: pre-wrap;
      }
      .empty {
        padding: 40px;
        text-align: center;
        border: 1px dashed var(--border);
        border-radius: 9px;
        color: var(--muted);
      }
      footer {
        border-top: 1px solid var(--border);
        margin-top: 28px;
        padding-top: 16px;
        font-size: 12px;
        color: var(--muted);
      }
      [hidden] {
        display: none !important;
      }
      #ads {
        margin-bottom: 30px;
        overflow-wrap: anywhere;
      }
      #ads summary {
        cursor: pointer;
        padding: 10px 0;
      }
      .ad-document, .ad-placement {
        border-top: 1px solid var(--border);
        margin-top: 12px;
      }
      .ad-placement > summary { font-weight: 650; }
      .ad-placement > .mono { white-space: pre-wrap; }
      .ad-table-wrap { overflow-x: auto; margin: 12px 0; }
      .ad-table { min-width: 660px; }
      .ad-table th:nth-child(1) { width: 20%; }
      .ad-table th:nth-child(2) { width: 23%; }
      .ad-table th:nth-child(3) { width: 27%; }
      .ad-table .notice { display: block; }
      @media (max-width: 700px) {
        main {
          padding: 24px 16px 70px;
        }
        h1 {
          font-size: 30px;
        }
        .stats {
          grid-template-columns: repeat(2, 1fr);
        }
        .context,
        .messages {
          grid-template-columns: 1fr;
        }
        .exchange > summary {
          grid-template-columns: 16px 44px minmax(0, 1fr) 40px;
          gap: 8px;
          padding: 14px 10px;
        }
        .duration {
          display: none;
        }
        .stat,
        .panel {
          padding: 16px;
        }
        .toolbar input {
          width: 100%;
        }
        .bars li {
          gap: 8px;
        }
        .meta {
          flex-direction: column;
          gap: 4px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header id="overview">
        <div class="masthead">
          <div class="eyebrow">Network audit / Android capture</div>
          <button type="button" id="theme" aria-label="Toggle dark mode">
            Theme
          </button>
        </div>
        <div class="title">
          <h1>{{ metadata.app }}</h1>
          <span class="pill" data-state="{{ metadata.state }}"
            >{{ metadata.state }}</span
          >
        </div>
        <div class="meta">
          <span class="mono muted">{{ metadata.get('package', '') }}</span
          ><span class="mono muted">{{ metadata.started }}</span>
        </div>
      </header>
      <section class="stats" aria-label="Capture totals" id="totals">
        <div class="stat">
          <strong>{{ flows|length }}</strong><span>HTTP exchanges</span>
        </div>
        <div class="stat">
          <strong>{{ host_counts|length }}</strong><span>Matched hosts</span>
        </div>
        <div class="stat">
          <strong>{{ '{:,.1f}'.format(total_bytes / 1024) }} KB</strong
          ><span>Response body bytes, on wire</span>
        </div>
        <div class="stat">
          <strong>{{ errors }}</strong><span>HTTP errors / incomplete</span>
        </div>
      </section>
      <div class="context">
        <section class="panel" id="hosts">
          <h2>Requests by host</h2>
          <figure aria-label="HTTP exchange counts by host">
            <ul class="bars">
              {% for host, count in host_counts %}
              <li>
                <span>{{ host }}</span>
                <meter min="0" max="{{ max_host_count }}" value="{{ count }}"
                  >{{ count }}</meter
                >
                <b>{{ count }}</b>
              </li>
              {% else %}
              <li class="empty-hosts">No matched hosts</li>
              {% endfor %}
            </ul>
          </figure>
        </section>
        <section class="panel" id="scope">
          <h2>Capture scope</h2>
          {% if metadata.get('backend') == 'ios' %}
          <p class="mono">Experimental iOS Simulator</p>
          <p class="mono">{{ metadata.domains|join(' · ') if metadata.domains is not none else 'All HTTP(S) requests reaching capture' }}</p>
          <p class="muted">{{ metadata.capture_scope }}.</p>
          <p class="notice">
            Native capture is not yet verified. Missing WebKit or system-helper
            traffic is not evidence of no requests. No certificate-pinning bypass
            or WebSocket frame capture. Unlike Android, QUIC is not blocked.
          </p>
          {% else %}
          {% if metadata.domains is none %}
          <p class="mono">All HTTP(S) requests</p>
          <p class="muted">
            HTTP(S) traffic from every domain reaching the proxy on the dedicated
            emulator, including native clients and WebView. No domain filter.
          </p>
          {% else %}
          <p class="mono">{{ metadata.domains|join(' · ') }}</p>
          <p class="muted">
            Selected-domain HTTP(S) traffic from a dedicated emulator, including
            native clients and WebView. Other domains are not included in this report.
          </p>
          {% endif %}
          <p class="notice">
            Not per-process attribution. No certificate-pinning bypass or
            WebSocket frame capture. QUIC is blocked to encourage TCP fallback.
          </p>
          {% endif %}
          {% if metadata.get('har') %}
          <p class="notice">
            {{ metadata.har }} separately contains all intercepted HTTP(S) hosts,
            including those outside this report's domain filter. Keep it private.
          </p>
          {% endif %}
        </section>
      </div>
      <section
        id="diagnostics"
        aria-label="Capture diagnostics"
        data-empty="{{ 'false' if diagnostics else 'true' }}"
      >
        {% for diagnostic in diagnostics %}
        <p>{{ diagnostic }}</p>
        {% endfor %}
      </section>
      <section id="ads" class="panel">
        <h2>Ad evidence · WebView observation ledger</h2>
        <p class="notice">Bid requests, responses and serving evidence, preserved across auctions and refreshes. STF won flags, Prebid win/render and GPT render are independent observations—not a highest-CPM winner or proof of a billable impression.</p>
        <p class="notice">CPM, original price and pbCg (the overlay’s price bucket) are separate. Amazon prices may be unavailable. HTTP capture is separate; no network correlation is inferred.</p>
        <div id="ad-evidence"></div>
      </section>
      <section id="requests">
        <h2>Request &amp; response explorer</h2>
        <div class="toolbar">
          <input
            id="search"
            type="search"
            aria-label="Search requests"
            placeholder="Search requests…"
          /><select id="host" aria-label="Filter host">
            <option value="">All hosts</option></select
          ><select id="status" aria-label="Filter result">
            <option value="">All results</option>
            <option value="errors">Errors / incomplete</option>
            <option value="success">HTTP 2xx / 3xx</option></select
          ><button id="reset" type="button">Reset</button>
        </div>
        <p class="notice" id="shown" aria-live="polite"></p>
        <div id="exchanges"></div>
        <p id="empty" class="empty" hidden>
          No matching exchanges. Check the filters or capture diagnostics.
        </p>
      </section>
      <footer id="privacy">
        Private capture · Headers, cookies, tokens and bodies are not redacted.
        Body previews may be truncated; complete captured exchanges are in
        flows.mitm. Binary previews are base64. This report loads no external
        resources.
      </footer>
    </main>
    <script type="application/json" id="audit-data">
      {{ {'flows': flows, 'metadata': metadata, 'ads': ads}|tojson }}
    </script>
    <script>
      "use strict";
      const theme = document.getElementById("theme");
      function updateTheme() {
        const dark = document.documentElement.classList.contains("dark");
        theme.textContent = dark ? "Light mode" : "Dark mode";
        theme.setAttribute("aria-pressed", String(dark));
      }
      theme.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("network-audit-theme", dark ? "dark" : "light");
        } catch {}
        updateTheme();
      });
      updateTheme();
      const { flows, ads } = JSON.parse(
        document.getElementById("audit-data").textContent,
      );
      const el = (tag, text, cls) => {
        const node = document.createElement(tag);
        if (text !== undefined) node.textContent = text;
        if (cls) node.className = cls;
        return node;
      };
      function evidence(parent, title, value) {
        const details = el("details");
        details.append(el("summary", title));
        details.addEventListener("toggle", () => {
          if (details.open && details.childElementCount === 1)
            details.append(el("pre", JSON.stringify(value, null, 2)));
        });
        parent.append(details);
        return details;
      }
      const list = (value) => Array.isArray(value) ? value : [];
      const known = (value) => value ?? "not observed";
      const price = (amount, currency) => amount == null ? "not observed" : `${amount} ${currency ?? "(currency unknown)"}`;
      const observationLabels = {
        bidRequested: "Bid requested", bidResponse: "Bid response", noBid: "No-bid observation",
        bidTimeout: "Timeout observation", bidRejected: "Bid rejected", bidWon: "Prebid win",
        adRenderSucceeded: "Prebid render succeeded", adRenderFailed: "Prebid render failed",
        slotRequested: "GPT request", slotResponseReceived: "GPT response", slotRenderEnded: "GPT render",
        slotOnload: "GPT creative loaded", impressionViewable: "GPT viewability event",
      };
      function bidTable(parent, observations) {
        const wrap = el("div", undefined, "ad-table-wrap");
        const table = el("table", undefined, "query-params ad-table");
        table.setAttribute("aria-label", "Bidder observations");
        const head = el("thead"), row = el("tr"), body = el("tbody");
        for (const label of ["Bidder / path", "Observation", "Price evidence", "Identifiers / evidence"]) {
          const th = el("th", label);
          th.scope = "col";
          row.append(th);
        }
        head.append(row);
        for (const {record, bid} of observations) {
          const tr = el("tr"), bidder = el("td", known(bid?.bidderCode ?? bid?.bidder));
          bidder.append(el("small", known(bid?.src ?? bid?.source), "notice"));
          const status = el("td", observationLabels[record.type] ?? record.type);
          status.append(el("small", `${record.source} · #${record.sequence}`, "notice"));
          const money = el("td", bid ? `CPM ${price(bid.cpm, bid.currency)}` : "—");
          if (bid) money.append(el("small", `Original ${price(bid.originalCpm, bid.originalCurrency)}\npbCg ${known(bid.pbCg)}`, "notice"));
          const ids = el("td");
          if (bid) ids.append(el("span", `Request ${known(bid.requestId ?? bid.bidId)}\nAd ${known(bid.adId)}\nBidder creative ${known(bid.creativeId)}`));
          else if (record.type === "slotRenderEnded") ids.append(el("span", `GAM line ${known(record.data.sourceAgnosticLineItemId ?? record.data.lineItemId)}\nGAM creative ${known(record.data.sourceAgnosticCreativeId ?? record.data.creativeId)}`));
          else if (record.data.adId) ids.append(el("span", `Ad ${record.data.adId}`));
          evidence(ids, "Raw observation", bid ? { bid, record } : record);
          tr.append(bidder, status, money, ids);
          body.append(tr);
        }
        table.append(head, body);
        wrap.append(table);
        parent.append(wrap);
      }
      const adRoot = document.getElementById("ad-evidence");
      adRoot.append(el("p", ads.collected
        ? `${ads.records.length} records · ${ads.documents.length} documents · append-only evidence`
        : "Not collected · no ad-event log. This is not evidence of no bids."));
      ads.diagnostics.forEach((text) => adRoot.append(el("p", text, "error")));
      for (const capture of ads.captures) {
        const hostRecords = capture.records.map((i) => ads.records[i]).filter((r) => r.source === "host");
        if (capture.partial) adRoot.append(el("p", "Partial capture: final flush missing or connection lost. Earlier records are retained.", "error"));
        for (const record of hostRecords.filter((r) => r.type === "diagnostic")) adRoot.append(el("p", record.data?.message, "error"));
        evidence(adRoot, `Capture transport · ${capture.partial ? "partial" : "final flush recorded"}`, hostRecords);
      }
      for (const document of ads.documents) {
        const records = document.records.map((i) => ads.records[i]);
        const section = el("details", undefined, "ad-document");
        const start = records.find((r) => r.type === "documentStarted");
        const page = start?.page ?? records[0]?.page ?? "Unknown page";
        section.open = page.startsWith("http");
        section.append(el("summary", `${page} · ${records.length} observation${records.length === 1 ? "" : "s"} · ${document.partial ? "partial document" : "end observed"}`));
        adRoot.append(section);
        const coverage = records.filter((r) => ["coverage", "documentStopped", "documentHidden"].includes(r.type)).at(-1)?.data ?? {};
        const prebidObserved = coverage.prebidObserved || records.some((r) => r.type === "instrumentation" && r.data.provider === "prebid");
        const gptObserved = coverage.gptObserved || records.some((r) => r.type === "instrumentation" && r.data.provider === "gpt");
        const stfObserved = coverage.stfObserved || records.some((r) => r.type === "slotSnapshot");
        section.append(el("p", `Installation: ${known(start?.data.installation)} · Prebid ${prebidObserved ? "observed" : "not observed"} · GPT ${gptObserved ? "observed" : "not observed"} · STF ${stfObserved ? "observed" : "not observed"}`, "notice"));
        if (document.partial) section.append(el("p", "No final document flush observed. Navigation or interruption may have lost the tail; earlier observations remain available.", "error notice"));
        if (start?.data.installation === "late-attach") section.append(el("p", "Late attachment: earlier events may be missing. Retained backfill may already have mutated.", "error"));
        const backfill = records.filter((r) => r.source === "backfill").length;
        if (backfill) section.append(el("p", `${backfill} backfilled records: retained vendor history, not event-time evidence.`, "notice"));
        section.append(el("p", "Missing instrumentation is not no bids. STF is sampled every 250 ms and at observed callbacks; transient states between samples may be missed. Only top-level pbjs / GPT / STF are observed.", "notice"));
        document.diagnostics.forEach((text) => section.append(el("p", text, "error")));
        for (const record of records.filter((r) => r.type === "diagnostic")) section.append(el("p", record.data.message, "error"));
        evidence(section, "Instrumentation, coverage, installation / late attachment and backfill diagnostics",
          records.filter((r) => ["documentStarted", "instrumentation", "coverage", "diagnostic", "documentStopped", "documentHidden"].includes(r.type)));
        // Exact identity only. Keep every mapping observation, including refresh changes.
        const mappings = new Map();
        const snapshots = records.filter((r) => r.type === "slotSnapshot");
        for (const record of snapshots) {
          for (const slot of list(record.data.slots)) {
            if (typeof slot.relevantPlacementId === "string") {
              if (!mappings.has(slot.relevantPlacementId)) mappings.set(slot.relevantPlacementId, []);
              mappings.get(slot.relevantPlacementId).push({sequence: record.sequence, slot});
            }
          }
        }
        evidence(section, `STF snapshot history (${snapshots.length}) · all mappings, refreshes, overlay bids and recorded wins`, snapshots);
        section.append(el("h3", "Placements & auctions"));
        const placements = new Map();
        for (const [code, history] of mappings) {
          const last = history.at(-1).slot;
          const placement = el("details", undefined, "ad-placement");
          placement.append(el("summary", `${last.placementCode ?? code} · ${history.length} snapshots`));
          placement.append(el("p", `STF ${known(last.key)} · DOM ${known(last.containerId)}\nPrebid ${code}\nGAM ${known(last.gptAdUnitPath)}`, "mono"));
          placement.append(el("p", "Grouped by exact observed Prebid code, not inferred names. Mapping history may change; this is not time-specific attribution.", "notice"));
          evidence(placement, "Placement mapping / refresh history", history);
          // Wins from snapshots remain separate from event-time Prebid/GPT rows.
          const wins = history.flatMap(({sequence, slot}) => list(slot.overlayBids)
            .filter((bid) => bid.won === true).map((bid) => ({ sequence, reloadCount: slot.reloadCount, bid })));
          evidence(placement, `STF won flags (${wins.length} snapshot observations)`, wins);
          evidence(placement, "GAM result history · order / line item / creative / response ID", history.map(({sequence, slot}) => ({sequence, reloadCount: slot.reloadCount, gptAdObj: slot.gptAdObj})));
          placements.set(code, placement);
          section.append(placement);
        }
        const unmatched = el("details", undefined, "ad-placement");
        unmatched.append(el("summary", "Unmatched / document-wide observations · retained without inferred identity"));
        section.append(unmatched);
        const auctions = new Map();
        const addObservation = (record, bid, auctionId) => {
          const codes = bid ? [bid.adUnitCode] : record.data.adUnitCodes;
          const matched = Array.isArray(codes) ? codes.filter((code) => placements.has(code)) : [];
          // Auction lifecycle evidence may name multiple exact placements. Show it
          // under each, while the raw ledger remains a single original record.
          for (const code of matched.length ? new Set(matched) : [null]) {
            const id = auctionId ?? "auction ID unavailable";
            const key = JSON.stringify([code, id]);
            if (!auctions.has(key)) auctions.set(key, {code, id, observations: []});
            auctions.get(key).observations.push({record, bid});
          }
        };
        for (const record of records) {
          if (["slotSnapshot", "documentStarted", "instrumentation", "coverage", "diagnostic", "documentStopped", "documentHidden"].includes(record.type)) continue;
          const data = record.data || {};
          const bids = Array.isArray(data.bids) ? data.bids : (data.bid ? [data.bid] : []);
          if (bids.length) for (const bid of bids) addObservation(record, bid, bid.auctionId ?? data.auctionId);
          else addObservation(record, null, data.auctionId);
        }
        for (const {code, id, observations} of auctions.values()) {
          const auction = el("details");
          auction.append(el("summary", `Auction ${id} · ${observations.length} observations`));
          (placements.get(code) || unmatched).append(auction);
          auction.addEventListener("toggle", () => {
            if (auction.open && auction.childElementCount === 1) bidTable(auction, observations);
          });
        }
        evidence(section, "Document raw ledger · original order", records);
      }
      evidence(adRoot, "Complete raw ad ledger · includes unsupported and unmatched records", ads.records);
      const host = document.getElementById("host"),
        status = document.getElementById("status"),
        search = document.getElementById("search");
      [...new Set(flows.map((f) => f.host))].sort().forEach((name) => {
        const option = el("option", name);
        option.value = name;
        host.append(option);
      });
      function pretty(body) {
        try {
          return JSON.stringify(JSON.parse(body), null, 2);
        } catch {
          return body;
        }
      }
      function message(title, value, urlParts) {
        const section = el("section", undefined, "message");
        section.append(el("h3", title));
        if (!value) {
          section.append(el("p", "No response captured.", "error"));
          return section;
        }
        section.append(
          el(
            "p",
            `${value.http_version} · ${value.bytes ?? "unknown"} body bytes`,
            "notice",
          ),
        );
        if (urlParts !== undefined) {
          section.append(
            el("h3", "Path"),
            el("pre", urlParts ? urlParts.path : "(URL could not be parsed)"),
          );
          const query = el("details");
          query.open = true;
          query.append(
            el(
              "summary",
              urlParts
                ? `Query parameters (${urlParts.query.length})`
                : "Query parameters",
            ),
          );
          if (urlParts && urlParts.query.length) {
            const table = el("table", undefined, "query-params");
            table.setAttribute("aria-label", "Query parameters");
            const head = el("thead"),
              headings = el("tr"),
              body = el("tbody");
            for (const label of ["Key", "Value"]) {
              const heading = el("th", label);
              heading.scope = "col";
              headings.append(heading);
            }
            head.append(headings);
            for (const [key, value] of urlParts.query) {
              const row = el("tr");
              row.append(el("td", key), el("td", value));
              body.append(row);
            }
            table.append(head, body);
            query.append(table);
          } else {
            query.append(
              el("pre", urlParts ? "(none)" : "(URL could not be parsed)"),
            );
          }
          section.append(query);
        }
        const headers = el("details");
        headers.open = true;
        headers.append(
          el("summary", `Headers (${value.headers.length})`),
          el(
            "pre",
            value.headers.map(([k, v]) => `${k}: ${v}`).join("\n") || "(none)",
          ),
        );
        section.append(headers);
        if (value.trailers.length) {
          section.append(
            el("h3", "Trailers"),
            el("pre", value.trailers.map(([k, v]) => `${k}: ${v}`).join("\n")),
          );
        }
        section.append(
          el(
            "h3",
            value.body_text !== null
              ? "Body · decoded text"
              : "Body · base64 wire bytes",
          ),
        );
        section.append(
          el(
            "pre",
            value.missing
              ? "(body unavailable)"
              : value.body_text !== null
                ? pretty(value.body_text) || "(empty)"
                : value.body_base64 || "(empty)",
          ),
        );
        if (value.truncated)
          section.append(
            el(
              "p",
              "Preview truncated. Full captured body is in flows.mitm.",
              "error notice",
            ),
          );
        return section;
      }
      function render() {
        const query = search.value.toLowerCase();
        const selected = flows.filter((f) => {
          const failed = !!f.error || !f.response || f.response.status >= 400;
          return (
            (!host.value || host.value === f.host) &&
            (!status.value || (status.value === "errors" ? failed : !failed)) &&
            (!query || JSON.stringify(f).toLowerCase().includes(query))
          );
        });
        const container = document.getElementById("exchanges");
        container.replaceChildren();
        selected.forEach((f) => {
          const row = el("details", undefined, "exchange");
          row.id = `flow-${f.id}`;
          const summary = el("summary");
          const code = f.response ? String(f.response.status) : "ERR";
          summary.append(
            el("span", f.method),
            el("span", f.url, "url"),
            el(
              "span",
              code,
              Number(code) >= 400 || f.error || !f.response
                ? "status error"
                : "status",
            ),
            el(
              "span",
              f.duration_ms === null ? "—" : `${f.duration_ms.toFixed(0)} ms`,
              "duration",
            ),
          );
          row.append(summary);
          row.addEventListener("toggle", () => {
            if (!row.open || row.childElementCount > 1) return;
            const detail = el("div", undefined, "detail");
            detail.append(el("p", f.url, "mono full-url"));
            if (f.error) detail.append(el("p", f.error, "error"));
            const messages = el("div", undefined, "messages");
            messages.append(
              message("Request", f.request, f.url_parts),
              message("Response", f.response),
            );
            detail.append(messages);
            row.append(detail);
          });
          container.append(row);
        });
        document.getElementById("shown").textContent =
          `${selected.length} of ${flows.length} exchanges · Select a row to inspect path, query parameters, headers and body`;
        document.getElementById("empty").hidden = selected.length !== 0;
      }
      search.addEventListener("input", render);
      host.addEventListener("change", render);
      status.addEventListener("change", render);
      document.getElementById("reset").addEventListener("click", () => {
        search.value = host.value = status.value = "";
        render();
      });
      render();
    </script>
  </body>
</html>
