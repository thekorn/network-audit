Key the writable Gradle project by the SDK's store directory, not just its
engine revision. Repackaged SDKs can share an engine but have different source
paths; reusing their symlinks either builds old code or fails after Nix GC.
Keep Flutter's Gradle/Kotlin cache arguments in the same SDK-specific directory.

--- a/packages/flutter_tools/gradle/settings.gradle
+++ b/packages/flutter_tools/gradle/settings.gradle
@@ -1,3 +1,3 @@
-def engineShortRev = (new File("$settingsDir/../../../bin/internal/engine.version")).text.take(10)
-def dir = new File("$System.env.HOME/.cache/flutter/nix-flutter-tools-gradle/$engineShortRev")
+def sdkDirectory = new File(settingsDir, "../../..").canonicalFile.name
+def dir = new File("$System.env.HOME/.cache/flutter/nix-flutter-tools-gradle/$sdkDirectory")
 dir.mkdirs()
--- a/packages/flutter_tools/lib/src/android/gradle_utils.dart
+++ b/packages/flutter_tools/lib/src/android/gradle_utils.dart
@@ -244,5 +244,5 @@
       },
       'flutter',
       'nix-flutter-tools-gradle',
-      globals.flutterVersion.engineRevision.substring(0, 10),
+      basename(globals.fs.directory(Cache.flutterRoot!).resolveSymbolicLinksSync()),
     );
