{ pkgs }:

# nixpkgs currently ships 3.47.4; use its normal SDK builder and runtime
# wrappers with metadata generated by its updater for stable 3.47.7.
# Remove the version override once the locked nixpkgs provides that release
# or newer; keep the permission fix until the packaged SDK includes it.
pkgs.flutterPackages.wrapFlutter (
  pkgs.flutterPackages.mkFlutter (
    (builtins.fromJSON (builtins.readFile ./flutter.json))
    // {
      patches = pkgs.flutter.unwrapped.patches ++ pkgs.lib.optionals pkgs.stdenv.hostPlatform.isDarwin [
        # macOS openrsync ignores --chmod when copying immutable SDK artifacts.
        # Make only the copied frameworks writable before lipo/codesigning.
        (pkgs.fetchpatch {
          url = "https://github.com/flutter/flutter/commit/92041655586094519e44bc471b3700765b81c8c8.patch";
          hash = "sha256-7egz/j0V74AJimjrT8UkB4dABVd9FyXwb9XsIu5Xn6g=";
        })
      ];
    }
  )
)
