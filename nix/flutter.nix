{ pkgs }:

# nixpkgs currently ships 3.47.4; use its normal SDK builder and runtime
# wrappers with metadata generated by its updater for stable 3.47.7.
# Remove this override once the locked nixpkgs provides that release or newer.
pkgs.flutterPackages.wrapFlutter (
  pkgs.flutterPackages.mkFlutter (
    (builtins.fromJSON (builtins.readFile ./flutter.json))
    // {
      inherit (pkgs.flutter.unwrapped) patches;
    }
  )
)
